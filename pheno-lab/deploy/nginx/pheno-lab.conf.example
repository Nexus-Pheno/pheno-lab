limit_req_zone $binary_remote_addr zone=pheno_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=pheno_ingest:10m rate=120r/m;
limit_req_zone $binary_remote_addr zone=pheno_health:1m rate=30r/m;

upstream pheno_lab_next {
    server 127.0.0.1:3457;
    keepalive 32;
}

server {
    listen 80;
    server_name lab.szkl.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name lab.szkl.com;

    ssl_certificate /etc/letsencrypt/live/lab.szkl.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lab.szkl.com/privkey.pem;

    client_max_body_size 25m;

    location = /api/health/live {
        limit_req zone=pheno_health burst=10 nodelay;
        proxy_pass http://pheno_lab_next;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Request-ID $request_id;
    }

    # Readiness is an operational endpoint. Keep it private and let the release
    # script call Next directly on loopback with HEALTHCHECK_TOKEN.
    location = /api/health/ready {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        deny all;
        limit_req zone=pheno_health burst=5 nodelay;
        proxy_pass http://pheno_lab_next;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Request-ID $request_id;
    }

    location = /login {
        limit_req zone=pheno_login burst=5 nodelay;
        proxy_pass http://pheno_lab_next;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location ^~ /api/ingest/ {
        limit_req zone=pheno_ingest burst=60 nodelay;
        proxy_pass http://pheno_lab_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
        proxy_request_buffering off;
    }

    location / {
        proxy_pass http://pheno_lab_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}
