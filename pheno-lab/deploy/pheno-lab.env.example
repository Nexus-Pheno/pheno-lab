# This file must remain root-owned, mode 0640, and shell-compatible because the
# release script sources it for `prisma migrate deploy`.
APP_VERSION=20260824-001
DATABASE_URL='postgresql://pheno_app:replace-me@10.0.2.10:5432/pheno_lab?connection_limit=10'
SESSION_SECRET='replace-with-a-long-random-session-secret'
SESSION_COOKIE_SECURE=true
INGEST_CRON_SECRET='replace-with-a-long-random-ingest-secret'
HEALTHCHECK_TOKEN='replace-with-a-long-random-health-token'
AI_CREDENTIAL_KEY='replace-with-output-of-openssl-rand-base64-32'

STORAGE_DRIVER=local
UPLOAD_DIR=/var/lib/pheno-lab/uploads
BACKUP_DIR=/var/lib/pheno-lab/backups
PG_DUMP_BIN=/usr/bin/pg_dump

# COS cutover (do not enable until the private bucket and CAM role are ready):
# STORAGE_DRIVER=cos
# COS_REGION=ap-guangzhou
# COS_FILES_BUCKET=pheno-lab-prod-files-APPID
# COS_AUTH_MODE=instance-role
# During migration only, keep the old directory read-only as a fallback. New
# writes still go exclusively to COS. Remove this after migration verification.
# COS_LEGACY_UPLOAD_DIR=/var/lib/pheno-lab/uploads
# Static credentials are supported for non-CVM environments only. Prefer a CVM
# instance role in production and never commit these values.
# COS_AUTH_MODE=static
# COS_SECRET_ID=replace-me
# COS_SECRET_KEY=replace-me

# Optional mail delivery; configure HOST, USER and PASS together.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=pheno-lab
# SMTP_PASS=replace-me
# SMTP_FROM=pheno-lab@example.com
