# Runtime
NODE_ENV=development
APP_VERSION=dev
DATABASE_URL="postgresql://pheno_app:change-me@127.0.0.1:5432/pheno_lab"
SESSION_SECRET="replace-with-at-least-32-random-characters"
SESSION_COOKIE_SECURE=false
INGEST_CRON_SECRET="replace-with-at-least-24-random-characters"
HEALTHCHECK_TOKEN="replace-with-at-least-24-random-characters"
# AI_CREDENTIAL_KEY="output-of-openssl-rand-base64-32"

# Local development. Production uses deploy/pheno-lab.env.example and keeps
# writable data outside the immutable release tree.
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
BACKUP_DIR="./backups"
# PG_DUMP_BIN=/usr/bin/pg_dump

# Second milestone only: switch STORAGE_DRIVER to cos after COS is provisioned.
# COS_REGION=ap-guangzhou
# COS_FILES_BUCKET=pheno-lab-prod-files-APPID
# COS_AUTH_MODE=instance-role
# COS_SECRET_ID=
# COS_SECRET_KEY=
# Migration window only: COS writes stay primary; reads may fall back here.
# COS_LEGACY_UPLOAD_DIR=/var/lib/pheno-lab/uploads

# Optional SMTP. Configure HOST, USER and PASS together or leave all empty.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
