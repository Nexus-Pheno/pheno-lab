{
  "name": "pheno-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format:check": "prettier --check src/infrastructure src/modules tests vitest.config.mts vitest.integration.config.mts playwright.config.ts src/instrumentation.ts src/proxy.ts scripts/check-structure.ts scripts/check-schema-drift.ts scripts/check-deploy.ts scripts/encrypt-ai-keys.ts scripts/prepare-test-database.ts scripts/run-integration-tests.ts scripts/validate-runtime-config.ts scripts/verify.ts",
    "lint": "eslint",
    "structure:check": "tsx scripts/check-structure.ts",
    "deploy:check": "tsx scripts/check-deploy.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:prepare": "tsx scripts/prepare-test-database.ts",
    "test:db:drift": "tsx scripts/check-schema-drift.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "e2e": "playwright test",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smiles-drawer": "^2.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.1.2",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
